# Copy this file to .env or .env.local and adjust as needed
# Variables prefixed with VITE_ are readable by the app via import.meta.env, and are
# inlined into the bundle at build time. Variables the app never reads stay build-only.
#
# This is the build template: it holds only what a release build actually consumes. The
# dev/preview server proxy (VITE_API_SERVER + VITE_APP_PROXY) lives in .env.development
# instead — the app never reads that pair, so keeping it out of here is what guarantees a
# release bundle carries no machine-specific address.

# API base path (must match the mount path of the data API), default /api/v1
VITE_APP_BASE_API=/api/v1

# Maximum number of chart points, default 60
VITE_APP_MAX_POINTS=60

# Link speed (Mbps), used only as a fallback when the backend
# /interfaces/{name}/link-speed endpoint is unavailable, default 1000
VITE_APP_LINK_SPEED=1000

# Delay in milliseconds before auto-reconnecting after an SSE shutdown event, default 30000
VITE_APP_SSE_SHUTDOWN_RECONNECT_DELAY=30000
